<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.SmartVision" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/primary_coral</item>
        <item name="colorOnPrimary">@color/background_white</item>
        <item name="android:statusBarColor">@color/primary_coral</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.SmartVision.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/primary_coral</item>
        <item name="android:statusBarColor">@color/primary_coral</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
