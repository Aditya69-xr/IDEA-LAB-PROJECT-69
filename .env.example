# SmartVision Environment Configuration Template
# Copy this file to .env and configure your values

# Flask Core Security
SECRET_KEY=generate_a_strong_random_secret_here
FLASK_ENV=production
DEBUG=False
PORT=5000
HOST=0.0.0.0

# Session Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_HOURS=12

# Initial Admin Credentials (Provisioned on first database init)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeThisPasswordNow123!
INITIAL_ADMIN_NAME=Idea Lab Super Admin
INITIAL_ADMIN_EMAIL=idealab@college.edu

# Academic Attendance Configuration
DEFAULT_CLASSES_PER_DAY=10
MINIMUM_REQUIRED_ATTENDANCE_PCT=75.0

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=60/minute
